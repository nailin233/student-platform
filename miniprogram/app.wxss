page { background: #f6f7f3; color: #213b36; font-size: 32rpx; }
.container { padding: 32rpx; }
.title { font-size: 48rpx; font-weight: 700; margin-bottom: 16rpx; }
.card { background: #fff; border-radius: 16rpx; padding: 28rpx; margin: 20rpx 0; box-shadow: 0 4rpx 16rpx rgba(0,0,0,.06); }
.muted { color: #64756e; font-size: 28rpx; }
.primary { background: #236454; color: #fff; min-height: 88rpx; line-height: 88rpx; font-size: 32rpx; }
button { border-radius: 10rpx; }
