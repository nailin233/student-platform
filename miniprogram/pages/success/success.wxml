<view class="container">
  <view class="card result-card">
    <!-- 成功标记 -->
    <view class="check-circle">
      <text class="check-mark">✓</text>
    </view>

    <view class="result-title">报名已提交</view>

    <view wx:if="{{name}}" class="result-name">{{name}} 的报名信息已收到</view>

    <view class="muted result-desc">工作人员会尽快与您电话联系，确认课程安排与缴费方式。</view>

    <button class="primary back-btn" bindtap="back">返回课程列表</button>
  </view>
</view>
