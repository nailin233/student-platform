/* 课程列表页 · 局部样式（全局令牌见 app.wxss） */

/* 错误卡片中的重试按钮 */
.retry {
  margin-top: 24rpx;
}

/* 课程卡片头部：名称与价格左右分布 */
.course-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
}

.course-name {
  font-size: var(--font-title);
  font-weight: 600;
  color: var(--text-primary);
}

.course-price {
  flex: none;
  font-size: var(--font-title);
  font-weight: 600;
  color: var(--brand-color);
}

/* 学制 / 上课时间 */
.course-meta {
  margin-top: 12rpx;
  font-size: var(--font-caption);
  color: var(--text-secondary);
}

.course-meta .dot {
  margin: 0 8rpx;
}

.course-desc {
  margin-top: 8rpx;
}

/* 卡片底部的行动引导 */
.course-action {
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 2rpx solid var(--border-color);
  font-size: var(--font-caption);
  color: var(--brand-color);
  font-weight: 500;
}

/* 师资卡片 */
.teacher-card {
  margin-top: 8rpx;
}

.teacher-label {
  font-size: var(--font-caption);
  color: var(--text-secondary);
  margin-bottom: 8rpx;
}

.teacher-names {
  font-size: var(--font-body);
  color: var(--text-primary);
  font-weight: 500;
}
